{
    "name": "dukstra/nova-phone-field",
    "description": "Nova 5 phone number field with country-specific and custom input masks.",
    "keywords": [
        "laravel",
        "nova",
        "phone mask",
        "input mask"
    ],
    "homepage": "https://github.com/dukstra/nova-phone-field",
    "license": "MIT",
    "authors": [
        {
            "name": "Dukstra"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Dukstra\\NovaPhoneField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dukstra\\NovaPhoneField\\FieldServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/nova": "^5.0",
        "laravel/nova-devtool": "^1.11"
    },
    "repositories": [
        { "type": "composer", "url": "https://nova.laravel.com" }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
